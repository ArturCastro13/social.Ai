# IA de texto. Padrão: gemini (cota gratuita). Troque para "claude" para usar a Anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão gemini-flash-latest)
GEMINI_MODEL=
# Opcional, só se LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Opcional: modelo da Anthropic para pesquisa, sugestões e leitura de materiais (padrão claude-haiku-4-5)
ANTHROPIC_MODEL=
# Opcional: modelo que escreve a estratégia e os posts (padrão claude-sonnet-5, uns US$ 0,14 por análise).
# claude-haiku-4-5 custa metade, mas inventa mais e repete tese (ver auditoria em STATUS.md).
ANTHROPIC_MODEL_POSTS=
# Opcional: esforço do modelo dos posts quando não for Haiku (low, medium, high; padrão low)
ANTHROPIC_EFFORT_POSTS=
# Opcional: modelo da pesquisa de mercado na web (padrão claude-sonnet-5, uns US$ 0,15 por pesquisa)
ANTHROPIC_MODEL_PESQUISA=
# Pesquisa de mercado na web (concorrentes e o que está em alta), só com Claude.
# Limites por dia, por instância: por IP (padrão 5) e no total (padrão 50).
LIMITE_CONCORRENTES_POR_IP=
LIMITE_CONCORRENTES_DIA=

# Imagem do post com IA ("Criar imagem com IA"): o Claude escreve a direção de arte, a OpenAI gera a imagem
# sem texto e a arte põe o texto do post por cima. Precisa também do Supabase (bucket "posts") para guardar.
OPENAI_API_KEY=
# Opcional: modelo de imagem (padrão gpt-image-2) e qualidade (low, medium, high; padrão medium).
# gpt-image-2 medium em 1024x1536 custa uns US$ 0,041 por imagem; high, US$ 0,165.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
# Limites por dia, por instância: por IP (padrão 10) e no total (padrão 60).
LIMITE_IMAGENS_POR_IP=
LIMITE_IMAGENS_DIA=

# Supabase (banco e storage). Sem essas chaves o app salva em .data/ localmente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Assinatura: disabled por padrão. Apenas Stripe sandbox é aceito nesta entrega.
BILLING_MODE=disabled
# Origem pública exata da aplicação (https://dominio; http://localhost em desenvolvimento).
APP_ORIGIN=
# Credenciais somente de teste. Nunca usar sk_live nem preços/portal de produção.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=

# DEMO_MODE=1 força o modo demo (nenhuma chamada externa de IA). Útil no palco.
DEMO_MODE=

# Teto de análises com IA por dia, por instância (padrão 60; cada uma custa uns US$ 0,30)
LIMITE_GLOBAL_DIA=
# Limite de análises com IA por e-mail na demo (padrão 3)
LIMITE_ANALISES_POR_EMAIL=3
# Senha simples para as páginas /admin (opcional; vazio = aberto)
ADMIN_PASSWORD=
